# Public site URL used for metadata / canonical links.
NEXT_PUBLIC_SITE_URL=https://presence.app

# Direct APK download (GitHub Releases by default).
NEXT_PUBLIC_APK_URL=https://github.com/Sahin00789/presence-android-app/releases/latest/download/presence.apk

# Public release page (secondary button: release notes).
NEXT_PUBLIC_RELEASES_URL=https://github.com/Sahin00789/presence-android-app/releases/latest

# Advertising. Leave the AdSense values empty to render the built-in
# "advertise here" house ads instead.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Where "Advertise here" / contact links point.
NEXT_PUBLIC_CONTACT_EMAIL=hello@presence.app
